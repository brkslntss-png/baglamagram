---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { href, LANG_NAMES, LANGS, OG_LOCALE, splitPath, t, type Lang } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Sayfa yalnızca Türkçe mi (ör. tek dilli içerik) — yine de diğer dillerde arayüz çevrilir */
  noindex?: boolean;
  jsonLd?: object;
}
const { title, description, image, noindex = false, jsonLd } = Astro.props;
const split = splitPath(Astro.url.pathname) as { lang: Lang; page: string };
const lang = split.lang;
const page = split.page.startsWith('404') ? '' : split.page; // 404 sayfası diğer dillerin ana sayfasına bağlanır
const site = 'https://baglamagram.com.tr';
const canonical = new URL(href(lang, page), site).toString();
const fullTitle = title ? `${title} | Mahmut Burak ASLANTAŞ` : `Mahmut Burak ASLANTAŞ — ${t(lang, 'site.tagline')}`;
const desc = description || t(lang, 'site.description');
const ogImage = image || `${site}/img/og.jpg`;

const csp = [
  "default-src 'self'",
  "script-src 'self'",
  "style-src 'self' 'unsafe-inline'",
  "img-src 'self' data: https:",
  "font-src 'self' data:",
  "media-src 'self' https:",
  "frame-src https://www.youtube-nocookie.com https://www.youtube.com https://open.spotify.com",
  "connect-src 'self' https://formspree.io https://firestore.googleapis.com https://us-central1-baglamagram-portal.cloudfunctions.net",
  "form-action https://formspree.io",
  "object-src 'none'",
  "base-uri 'self'",
].join('; ');
---
<!doctype html>
<html lang={lang} data-lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {noindex ? <meta name="robots" content="noindex" /> : null}
    <link rel="canonical" href={canonical} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={new URL(href(l, page), site).toString()} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(href('tr', page), site).toString()} />
    <meta name="theme-color" content="#0a0a0b" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/img/icon-512.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="baglamagram" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd ? <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} /> : null}
  </head>
  <body>
    <Header lang={lang} page={page} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />

    <div class="lang-hint" hidden data-lang-hint>
      {LANGS.filter((l) => l !== lang).map((l) => (
        <a href={href(l, page)} data-hint-lang={l} data-set-lang={l} hidden>{t(l, 'lang.switch', { lang: LANG_NAMES[l] })}</a>
      ))}
      <button type="button" aria-label={t(lang, 'nav.close')} data-hint-close>×</button>
    </div>

    <style>
      .lang-hint { position: fixed; left: 50%; bottom: 20px; transform: translateX(-50%); z-index: 40; display: flex; align-items: center; gap: 6px; padding: 6px 6px 6px 16px; border-radius: 999px; background: rgba(22, 22, 25, 0.92); border: 1px solid var(--gold-line); box-shadow: var(--shadow); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); font-size: 14px; }
      .lang-hint[hidden] { display: none; }
      .lang-hint a { color: var(--gold-2); font-weight: 600; }
      .lang-hint button { width: 32px; height: 32px; border-radius: 50%; border: 0; background: rgba(255, 255, 255, 0.06); color: var(--text-2); cursor: pointer; font-size: 18px; line-height: 1; }
    </style>

    <script>
      // Görünür olunca yumuşak geliş
      const io = 'IntersectionObserver' in window
        ? new IntersectionObserver((entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io?.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' })
        : null;
      document.querySelectorAll('.reveal').forEach((el) => (io ? io.observe(el) : el.classList.add('in')));

      // Dış sitedeki bir görsel açılmazsa kırık simge yerine boş kutu kalsın; bir galerinin hepsi açılmazsa galeri gizlensin
      const broken = (img: HTMLImageElement) => {
        img.classList.add('img-broken');
        const box = img.closest<HTMLElement>('[data-hide-if-broken]');
        if (box && [...box.querySelectorAll('img')].every((i) => i.classList.contains('img-broken'))) box.hidden = true;
      };
      document.addEventListener('error', (e) => { if (e.target instanceof HTMLImageElement) broken(e.target); }, true);
      document.querySelectorAll('img').forEach((img) => { if (img.complete && img.naturalWidth === 0 && img.currentSrc) broken(img); });

      // Tarayıcı dili farklıysa küçük bir öneri (otomatik yönlendirme yok)
      try {
        const pageLang = document.documentElement.dataset.lang;
        const saved = localStorage.getItem('bg_lang');
        const dismissed = sessionStorage.getItem('bg_hint_closed');
        const nav = (navigator.language || 'tr').slice(0, 2);
        const want = ['tr', 'en', 'de', 'ru'].includes(nav) ? nav : 'en';
        if (!saved && !dismissed && want !== pageLang) {
          const hint = document.querySelector<HTMLElement>('[data-lang-hint]');
          const link = hint?.querySelector<HTMLElement>(`[data-hint-lang="${want}"]`);
          if (hint && link) { link.hidden = false; hint.hidden = false; }
          hint?.querySelector('[data-hint-close]')?.addEventListener('click', () => { hint.hidden = true; sessionStorage.setItem('bg_hint_closed', '1'); });
        }
      } catch (_) {}
    </script>
  </body>
</html>
