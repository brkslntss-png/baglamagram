---
import Base from '../../layouts/Base.astro';
import Icon from '../Icon.astro';
import { href, LOCALE, t, type Lang } from '../../i18n';
import { APP, FORMSPREE, WHATSAPP } from '../../data/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const features = [
  ['video', 'edu.f.live'],
  ['moon', 'edu.f.time'],
  ['mic', 'edu.f.hw'],
  ['sparkles', 'edu.f.ai'],
  ['gamepad-2', 'edu.f.tools'],
  ['message-circle', 'edu.f.chat'],
] as const;
const portal = ['edu.portal.i1', 'edu.portal.i2', 'edu.portal.i3', 'edu.portal.i4'] as const;
// iPhone kurulum kılavuzu: Safari → ••• → Paylaş → Ana Ekrana Ekle → Ekle (ekran görüntüleri /img/ios/)
const LOGIN_URL = 'https://baglamagram.com.tr/portal/?e=Login';
const iosSteps = [1, 2, 3, 4, 5] as const;
const mock = {
  tr: { hi: 'Merhaba', next: 'Sıradaki ders', when: 'Bugün 19:00', hw: 'Ödevin var', hwt: 'Uşşak dizisi', streak: '5 gün seri', tabs: ['Ana Sayfa', 'Dersler', 'Pratik', 'Hoca', 'Profil'] },
  en: { hi: 'Hello', next: 'Next lesson', when: 'Today 7:00 PM', hw: 'Homework', hwt: 'Uşşak scale', streak: '5-day streak', tabs: ['Home', 'Lessons', 'Practice', 'Teacher', 'Profile'] },
  de: { hi: 'Hallo', next: 'Nächste Stunde', when: 'Heute 19:00', hw: 'Hausaufgabe', hwt: 'Uşşak-Leiter', streak: '5 Tage Serie', tabs: ['Start', 'Stunden', 'Üben', 'Lehrer', 'Profil'] },
  ru: { hi: 'Привет', next: 'Следующий урок', when: 'Сегодня 19:00', hw: 'Задание', hwt: 'Лад Ушшак', streak: 'Серия 5 дней', tabs: ['Главная', 'Уроки', 'Практика', 'Учитель', 'Профиль'] },
}[lang];
---
<Base title={t(lang, 'edu.title')} description={t(lang, 'edu.lead')}>
  <section class="page-hero">
    <div class="container hero">
      <div class="hero-text">
        <div class="stores">
          <button class="apk" type="button" data-ios-open aria-haspopup="dialog"><Icon name="apple" size={17} /><span>{t(lang, 'edu.ios')}</span></button>
          <a class="apk" href={APP.apk} rel="noopener" data-apk><Icon name="android" size={17} /><span>{t(lang, 'edu.apk')}</span><small>{t(lang, 'edu.apkVer', { v: APP.version })}</small></a>
        </div>
        <h1 class="title-xl">{t(lang, 'edu.title')}</h1>
        <p class="lead">{t(lang, 'edu.lead')}</p>
        <div class="cta">
          <a class="btn btn-gold" href="/portal/"><Icon name="log-in" size={18} />{t(lang, 'edu.login')}</a>
          <a class="btn btn-ghost" href={href(lang, 'magaza.html')}><Icon name="shopping-bag" size={18} />{t(lang, 'edu.apply')}</a>
          <a class="btn btn-ghost" href="#sertifika"><Icon name="badge-check" size={18} />{t(lang, 'edu.certBtn')}</a>
        </div>
      </div>
      <div class="device" aria-hidden="true">
        <div class="screen">
          <div class="s-top"><span class="s-brand"></span><span class="s-dots"><i></i><i></i></span></div>
          <div class="s-title">{mock.hi}</div>
          <div class="s-card s-blue"><span class="s-ic"><Icon name="calendar" size={16} /></span><div><b>{mock.next}</b><small>{mock.when}</small></div></div>
          <div class="s-card"><span class="s-ic s-orange"><Icon name="mic" size={16} /></span><div><b class="s-red">{mock.hw}</b><small>{mock.hwt}</small></div></div>
          <div class="s-card"><span class="s-ic s-flame"><Icon name="flame" size={16} /></span><div><b>{mock.streak}</b><small>●●●●●○○</small></div></div>
          <div class="s-tools"><i class="t1"></i><i class="t2"></i><i class="t3"></i><i class="t4"></i></div>
          <div class="s-tab">{mock.tabs.map((x, i) => <span class={i === 0 ? 'on' : ''}>{x}</span>)}</div>
        </div>
      </div>
    </div>
  </section>

  <dialog class="ios-guide" data-ios-guide aria-labelledby="ios-title">
    <div class="ig-head">
      <span class="ig-logo"><Icon name="apple" size={22} /></span>
      <div class="ig-head-text">
        <h2 id="ios-title">{t(lang, 'edu.ios.title')}</h2>
        <p>{t(lang, 'edu.ios.lead')}</p>
      </div>
      <button class="ig-close" type="button" data-ios-close aria-label={t(lang, 'edu.ios.close')}><Icon name="x" size={20} /></button>
    </div>
    <ol class="ig-steps">
      {iosSteps.map((n) => (
        <li class="ig-step">
          <img src={`/img/ios/adim-${n}.jpg`} width="540" height="1174" loading="lazy" decoding="async" alt={t(lang, `edu.ios.s${n}.t` as any)} />
          <div class="ig-text">
            <span class="ig-num">{t(lang, 'edu.ios.step', { n })}</span>
            <h3>{t(lang, `edu.ios.s${n}.t` as any)}</h3>
            <p>{t(lang, `edu.ios.s${n}.d` as any)}</p>
            {n === 1 ? <a class="btn btn-gold ig-link" href={LOGIN_URL}><Icon name="log-in" size={17} />{t(lang, 'edu.ios.open')}</a> : null}
          </div>
        </li>
      ))}
    </ol>
    <div class="ig-done">
      <span class="icon-tile"><Icon name="check" size={20} /></span>
      <div><h3>{t(lang, 'edu.ios.done.t')}</h3><p>{t(lang, 'edu.ios.done.d')}</p></div>
    </div>
  </dialog>

  <!-- Android: indirmeye dokununca güven veren pencere (kurulum adımları ve neden güvenli) -->
  <dialog class="ios-guide apk-guide" data-apk-guide aria-labelledby="apk-title">
    <div class="ig-head">
      <span class="ig-logo apk-logo"><Icon name="android" size={22} /></span>
      <div class="ig-head-text">
        <h2 id="apk-title">{t(lang, 'apk.title')}</h2>
        <p>{t(lang, 'apk.lead', { v: APP.version })}</p>
      </div>
      <button class="ig-close" type="button" data-apk-close aria-label={t(lang, 'edu.ios.close')}><Icon name="x" size={20} /></button>
    </div>
    <ol class="apk-steps">
      {(['apk.s1', 'apk.s2', 'apk.s3'] as const).map((k, i) => (
        <li><span class="apk-num">{i + 1}</span><p>{t(lang, k)}</p></li>
      ))}
    </ol>
    <div class="apk-safe">
      <h3><Icon name="shield-check" size={19} />{t(lang, 'apk.safeTitle')}</h3>
      <ul>
        {(['apk.safe1', 'apk.safe2', 'apk.safe3', 'apk.safe4'] as const).map((k) => (
          <li><Icon name="check" size={16} />{t(lang, k)}</li>
        ))}
      </ul>
    </div>
    <div class="apk-foot">
      <a class="apk-link" href={APP.apk} rel="noopener"><Icon name="download" size={16} />{t(lang, 'apk.again')}</a>
      <button class="apk-link" type="button" data-ios-open data-apk-close><Icon name="apple" size={16} />{t(lang, 'apk.iphone')}</button>
      <a class="apk-link" href={WHATSAPP} target="_blank" rel="noopener"><Icon name="whatsapp" size={16} />{t(lang, 'apk.help')}</a>
      <button class="btn btn-gold apk-ok" type="button" data-apk-close>{t(lang, 'apk.ok')}</button>
    </div>
  </dialog>

  <section class="section">
    <div class="container">
      <div class="section-head center reveal">
        <span class="eyebrow center">{t(lang, 'nav.edu')}</span>
        <h2 class="title-lg">{t(lang, 'edu.why')}</h2>
      </div>
      <div class="grid grid-3 reveal">
        {features.map(([icon, k]) => (
          <article class="card feature">
            <span class="icon-tile"><Icon name={icon} size={22} /></span>
            <h3>{t(lang, `${k}.t` as any)}</h3>
            <p>{t(lang, `${k}.d` as any)}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container portal reveal">
      <div>
        <h2 class="title-md">{t(lang, 'edu.portal.title')}</h2>
        <p class="muted">{t(lang, 'edu.portal.text')}</p>
      </div>
      <ul>
        {portal.map((k) => <li><Icon name="check" size={18} class="gold" />{t(lang, k)}</li>)}
      </ul>
      <div class="portal-cta">
        <a class="btn btn-gold" href="/portal/"><Icon name="log-in" size={18} />{t(lang, 'edu.login')}</a>
        <a class="btn btn-ghost" href={href(lang, 'magaza.html')}><Icon name="shopping-bag" size={18} />{t(lang, 'edu.apply')}</a>
      </div>
    </div>
  </section>

  <section class="section" id="basvuru">
    <div class="container form-wrap reveal">
      <div class="form-intro">
        <span class="eyebrow">{t(lang, 'footer.trial')}</span>
        <h2 class="title-lg">{t(lang, 'edu.form.title')}</h2>
        <p class="lead">{t(lang, 'edu.form.lead')}</p>
        <div class="card app-card">
          <span class="icon-tile"><Icon name="smartphone" size={22} /></span>
          <div><h3>{t(lang, 'edu.app.title')}</h3><p class="muted">{t(lang, 'edu.app.text')}</p></div>
        </div>
      </div>
      <form class="card form" action={FORMSPREE} method="POST" data-apply data-sent={t(lang, 'edu.form.sent')} data-error={t(lang, 'edu.form.error')}>
        <input type="hidden" name="_language" value={lang} />
        <input type="text" name="_gotcha" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="field"><label for="f-name">{t(lang, 'edu.form.name')}</label><input id="f-name" class="input" type="text" name="ad_soyad" autocomplete="name" required maxlength="80" /></div>
        <div class="field"><label for="f-tel">{t(lang, 'edu.form.phone')}</label><input id="f-tel" class="input" type="tel" name="telefon" autocomplete="tel" required maxlength="24" inputmode="tel" /></div>
        <div class="two">
          <div class="field"><label for="f-age">{t(lang, 'edu.form.age')}</label><input id="f-age" class="input" type="number" name="yas" min="16" max="99" required /></div>
          <div class="field"><label for="f-job">{t(lang, 'edu.form.job')}</label><input id="f-job" class="input" type="text" name="meslek" maxlength="60" /></div>
        </div>
        <div class="field">
          <label for="f-level">{t(lang, 'edu.form.level')}</label>
          <select id="f-level" class="select" name="seviye" required>
            <option value="" disabled selected>—</option>
            <option value="sifir">{t(lang, 'edu.form.level0')}</option>
            <option value="temel">{t(lang, 'edu.form.level1')}</option>
            <option value="ileri">{t(lang, 'edu.form.level2')}</option>
          </select>
        </div>
        <div class="field"><label for="f-msg">{t(lang, 'edu.form.msg')}</label><textarea id="f-msg" class="textarea" name="mesaj" rows="4" required maxlength="2000"></textarea></div>
        <button class="btn btn-gold" type="submit"><Icon name="send" size={17} />{t(lang, 'edu.form.send')}</button>
        <p class="note">{t(lang, 'edu.form.privacy')}</p>
        <p class="status" role="status" aria-live="polite" data-status></p>
      </form>
    </div>
  </section>

  <section class="section-tight" id="sertifika">
    <div class="container cert reveal">
      <div class="cert-intro">
        <span class="icon-tile"><Icon name="award" size={22} /></span>
        <div>
          <span class="eyebrow">{t(lang, 'edu.cert.eyebrow')}</span>
          <h2 class="title-md">{t(lang, 'edu.cert.title')}</h2>
          <p class="muted">{t(lang, 'edu.cert.lead')}</p>
        </div>
      </div>
      <form class="cert-form" data-cert
        data-wait={t(lang, 'edu.cert.wait')} data-btn={t(lang, 'edu.cert.btn')}
        data-valid={t(lang, 'edu.cert.valid')} data-invalid={t(lang, 'edu.cert.invalid')}
        data-invalid-text={t(lang, 'edu.cert.invalidText')} data-revoked={t(lang, 'edu.cert.revoked')}
        data-holder={t(lang, 'edu.cert.holder')} data-program={t(lang, 'edu.cert.program')} data-date={t(lang, 'edu.cert.date')}
        data-error={t(lang, 'edu.cert.error')} data-locale={LOCALE[lang]}
        data-p-muzik={t(lang, 'edu.cert.p.muzik')} data-p-yetenek={t(lang, 'edu.cert.p.yetenek')}
        data-p-baglama={t(lang, 'edu.cert.p.baglama')} data-p-yetenek_baglama={t(lang, 'edu.cert.p.yetenek_baglama')}>
        <label for="c-no">{t(lang, 'edu.cert.label')}</label>
        <div class="cert-row">
          <input id="c-no" class="input" type="text" name="no" placeholder="BG-2026-XXXX-XXXX" autocomplete="off" autocapitalize="characters" spellcheck="false" maxlength="24" required />
          <button class="btn btn-gold" type="submit"><Icon name="search" size={17} /><span data-cert-btn>{t(lang, 'edu.cert.btn')}</span></button>
        </div>
        <div class="cert-result" data-cert-result role="status" aria-live="polite" hidden></div>
        <p class="note">{t(lang, 'edu.cert.privacy')}</p>
      </form>
    </div>
  </section>
</Base>

<style>
  .portal-cta { display: flex; flex-wrap: wrap; gap: 12px; }
  .stores { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 6px; }
  .stores .apk { margin-bottom: 0; }
  button.apk { font: inherit; font-size: 14px; font-weight: 600; cursor: pointer; }
  .apk { align-self: flex-start; display: inline-flex; align-items: center; gap: 10px; height: 40px; padding: 0 16px 0 14px; border-radius: 999px; border: 1px solid var(--gold-line); background: rgba(210, 172, 99, 0.08); color: var(--gold-2); font-size: 14px; font-weight: 600; margin-bottom: 6px; transition: background 0.2s, border-color 0.2s; }
  .apk:hover { background: rgba(210, 172, 99, 0.16); border-color: var(--gold); }
  .apk small { font-size: 12px; font-weight: 500; color: var(--text-2); padding-left: 10px; border-left: 1px solid var(--line-2); }
  .hero { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 48px; align-items: center; }
  .hero-text { display: flex; flex-direction: column; gap: 22px; }
  .hero-text .title-xl { font-size: clamp(38px, 5.4vw, 72px); }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; }

  /* Uygulama önizlemesi (HTML ile çizilmiş temsili ekran) */
  .device { justify-self: center; width: 280px; aspect-ratio: 9 / 18.5; border-radius: 44px; padding: 10px; background: linear-gradient(160deg, #2a2a2e, #111113); border: 1px solid var(--line-2); box-shadow: 0 50px 120px -40px rgba(210, 172, 99, 0.35), var(--shadow); transform: rotate(3deg); }
  .screen { height: 100%; border-radius: 34px; background: #f2f2f7; color: #1c1c1e; padding: 18px 14px 12px; display: flex; flex-direction: column; gap: 9px; overflow: hidden; font-family: var(--sans); }
  .s-top { display: flex; justify-content: space-between; align-items: center; }
  .s-brand { width: 82px; height: 15px; background: #1c1c1e; -webkit-mask: url('/img/wordmark.png') left center / contain no-repeat; mask: url('/img/wordmark.png') left center / contain no-repeat; }
  .s-dots { display: flex; gap: 6px; } .s-dots i { width: 24px; height: 24px; border-radius: 50%; background: #34c759; } .s-dots i + i { background: #fff; border: 1px solid #e5e5ea; }
  .s-title { font-size: 24px; font-weight: 700; letter-spacing: -0.02em; margin: 4px 0 2px; }
  .s-card { display: flex; gap: 10px; align-items: center; background: #fff; border-radius: 16px; padding: 11px; }
  .s-card b { display: block; font-size: 12.5px; } .s-card small { font-size: 11px; color: #8a8a8e; }
  .s-ic { width: 32px; height: 32px; border-radius: 9px; display: grid; place-items: center; background: #5856d6; color: #fff; }
  .s-orange { background: #ff9500; } .s-flame { background: #ff3b30; } .s-red { color: #ff3b30; }
  .s-tools { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; padding: 4px 2px; }
  .s-tools i { aspect-ratio: 1; border-radius: 12px; } .t1 { background: #ff9500; } .t2 { background: #34c759; } .t3 { background: #007aff; } .t4 { background: #ff3b30; }
  .s-tab { margin-top: auto; display: flex; justify-content: space-between; background: rgba(255,255,255,0.9); border-radius: 22px; padding: 9px 8px; font-size: 8.5px; font-weight: 600; color: #1c1c1e; }
  .s-tab .on { color: #007aff; }

  /* Android indirme penceresi (iPhone kılavuzunun kabuğunu kullanır) */
  .apk-guide { width: min(620px, calc(100vw - 24px)); }
  .apk-logo { background: #3ddc84; color: #0a0a0b; }
  .apk-steps { list-style: none; margin: 0; padding: 18px 22px 4px; display: grid; gap: 12px; }
  .apk-steps li { display: flex; gap: 14px; align-items: flex-start; }
  .apk-steps p { margin: 0; font-size: 15px; color: var(--text); line-height: 1.5; }
  .apk-num { flex: none; width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center; background: var(--gold); color: #15110a; font-weight: 800; font-size: 14px; }
  .apk-safe { margin: 16px 22px 0; padding: 16px 18px; border-radius: 18px; border: 1px solid color-mix(in srgb, var(--ok) 45%, transparent); background: color-mix(in srgb, var(--ok) 8%, transparent); }
  .apk-safe h3 { display: flex; gap: 8px; align-items: center; font-size: 16px; margin: 0 0 10px; color: var(--ok); }
  .apk-safe ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 9px; }
  .apk-safe li { display: flex; gap: 9px; font-size: 14.5px; color: var(--text-2); line-height: 1.5; }
  .apk-safe li :global(.icon) { color: var(--ok); margin-top: 3px; }
  .apk-foot { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; padding: 16px 22px 22px; }
  .apk-link { display: inline-flex; gap: 8px; align-items: center; font: inherit; font-size: 14px; font-weight: 600; color: var(--gold-2); background: none; border: 0; padding: 0; cursor: pointer; text-align: left; }
  .apk-ok { align-self: stretch; justify-content: center; margin-top: 6px; }
  @media (max-width: 560px) { .apk-steps { padding: 14px 16px 2px; } .apk-safe { margin: 14px 14px 0; } .apk-foot { padding: 14px 16px 18px; } }

  /* iPhone kurulum kılavuzu: ekranın bir kısmını kaplayan pencere, arka plan bulanık */
  .ios-guide { width: min(760px, calc(100vw - 24px)); max-height: min(88vh, 900px); padding: 0; border: 1px solid var(--line-2); border-radius: 26px; background: var(--surface); color: var(--text); box-shadow: 0 40px 120px -30px rgba(0, 0, 0, 0.7); overflow: auto; overscroll-behavior: contain; }
  .ios-guide::backdrop { background: rgba(6, 6, 10, 0.5); -webkit-backdrop-filter: blur(12px) saturate(120%); backdrop-filter: blur(12px) saturate(120%); }
  .ios-guide[open] { animation: ig-in 0.28s cubic-bezier(0.2, 0.8, 0.2, 1); }
  @keyframes ig-in { from { opacity: 0; transform: translateY(16px) scale(0.98); } to { opacity: 1; transform: none; } }
  .ig-head { position: sticky; top: 0; z-index: 1; display: flex; gap: 14px; align-items: flex-start; padding: 22px 22px 18px; background: color-mix(in srgb, var(--surface) 92%, transparent); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); border-bottom: 1px solid var(--line); }
  .ig-logo { flex: none; width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center; background: var(--text); color: var(--bg, #000); }
  .ig-head-text { flex: 1; min-width: 0; }
  .ig-head h2 { font-size: 22px; margin: 2px 0 6px; }
  .ig-head p { font-size: 14.5px; color: var(--text-2); margin: 0; }
  .ig-close { flex: none; width: 38px; height: 38px; border-radius: 50%; border: 1px solid var(--line-2); background: transparent; color: var(--text); display: grid; place-items: center; cursor: pointer; }
  .ig-close:hover { background: rgba(255, 255, 255, 0.06); }
  .ig-steps { list-style: none; margin: 0; padding: 18px 22px 4px; display: grid; gap: 18px; }
  .ig-step { display: grid; grid-template-columns: 170px 1fr; gap: 20px; align-items: center; padding: 14px; border: 1px solid var(--line); border-radius: 20px; background: rgba(255, 255, 255, 0.02); }
  .ig-step img { width: 100%; height: auto; border-radius: 16px; border: 1px solid var(--line-2); display: block; }
  .ig-text { display: flex; flex-direction: column; gap: 8px; align-items: flex-start; min-width: 0; overflow-wrap: anywhere; }
  .ig-num { font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--gold-2); }
  .ig-text h3 { font-size: 19px; margin: 0; }
  .ig-text p { font-size: 15px; color: var(--text-2); margin: 0; }
  .ig-link { margin-top: 6px; }
  .ig-done { display: flex; gap: 14px; align-items: center; margin: 14px 22px 22px; padding: 16px; border-radius: 18px; border: 1px solid var(--gold-line); background: rgba(210, 172, 99, 0.08); }
  .ig-done h3 { font-size: 17px; margin: 0 0 4px; }
  .ig-done p { font-size: 14.5px; color: var(--text-2); margin: 0; }
  @media (max-width: 560px) {
    .ig-step { grid-template-columns: 112px 1fr; gap: 14px; padding: 10px; }
    .ig-head { padding: 18px 16px 14px; } .ig-steps { padding: 14px 14px 2px; } .ig-done { margin: 12px 14px 16px; }
    .ig-head h2 { font-size: 19px; } .ig-head p { font-size: 13.5px; }
    .ig-logo { width: 38px; height: 38px; border-radius: 10px; }
    .ig-text h3 { font-size: 17px; } .ig-text p { font-size: 14px; }
  }

  .feature { padding: 28px; display: flex; flex-direction: column; gap: 14px; }
  .feature h3 { font-size: 18px; }
  .feature p { color: var(--text-2); font-size: 15px; }

  .portal { width: calc(100% - 2 * var(--gutter)); display: grid; grid-template-columns: 1fr 1.2fr auto; gap: 32px; align-items: center; padding: 32px; border: 1px solid var(--gold-line); border-radius: var(--radius-lg); background: radial-gradient(120% 140% at 0% 0%, rgba(210, 172, 99, 0.1), transparent 60%), var(--surface); }
  .portal ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .portal li { display: flex; gap: 10px; align-items: flex-start; color: var(--text-2); }
  .portal .title-md { margin-bottom: 8px; }

  .form-wrap { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(28px, 5vw, 64px); align-items: start; }
  .form-intro { display: flex; flex-direction: column; gap: 18px; position: sticky; top: calc(var(--header-h) + 24px); }
  .app-card { padding: 20px; display: flex; gap: 16px; margin-top: 8px; }
  .app-card h3 { font-size: 16px; margin-bottom: 4px; }
  .app-card p { font-size: 14px; }
  .form { padding: clamp(20px, 3vw, 32px); display: flex; flex-direction: column; gap: 16px; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .note { font-size: 13px; color: var(--text-3); text-align: center; }
  .status { min-height: 1.2em; text-align: center; font-weight: 600; }
  .status.ok { color: var(--ok); } .status.err { color: var(--err); }

  /* Sertifika sorgulama */
  .cert { width: calc(100% - 2 * var(--gutter)); display: grid; grid-template-columns: 1fr 1.1fr; gap: 32px; align-items: start; padding: 32px; border: 1px solid var(--gold-line); border-radius: var(--radius-lg); background: radial-gradient(120% 140% at 100% 0%, rgba(210, 172, 99, 0.1), transparent 60%), var(--surface); }
  .cert-intro { display: flex; gap: 16px; align-items: flex-start; }
  .cert-intro .icon-tile { flex: none; }
  .cert-intro .title-md { margin: 4px 0 8px; }
  .cert-form { display: flex; flex-direction: column; gap: 10px; }
  .cert-form label { font-size: 14px; font-weight: 600; color: var(--text-2); }
  .cert-row { display: flex; gap: 10px; }
  .cert-row .input { flex: 1; min-width: 0; font-variant-numeric: tabular-nums; letter-spacing: 0.04em; text-transform: uppercase; }
  .cert-row .btn { flex: none; }
  .cert-result { display: flex; gap: 14px; align-items: flex-start; padding: 16px; border-radius: 18px; border: 1px solid var(--line-2); background: rgba(255, 255, 255, 0.02); }
  .cert-result.ok { border-color: color-mix(in srgb, var(--ok) 55%, transparent); background: color-mix(in srgb, var(--ok) 9%, transparent); }
  .cert-result.bad { border-color: color-mix(in srgb, var(--err) 55%, transparent); background: color-mix(in srgb, var(--err) 8%, transparent); }
  .cert-result :global(.mark) { flex: none; width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; font-size: 19px; font-weight: 800; color: #fff; }
  .cert-result.ok :global(.mark) { background: var(--ok); } .cert-result.bad :global(.mark) { background: var(--err); }
  .cert-result :global(h3) { font-size: 17px; margin: 4px 0 8px; }
  .cert-result :global(dl) { display: grid; grid-template-columns: auto 1fr; gap: 4px 14px; margin: 0; font-size: 14.5px; }
  .cert-result :global(dt) { color: var(--text-3); } .cert-result :global(dd) { margin: 0; font-weight: 600; overflow-wrap: anywhere; }
  .cert-result :global(p) { margin: 0; color: var(--text-2); font-size: 14.5px; }
  @media (max-width: 960px) { .cert { grid-template-columns: 1fr; } }
  @media (max-width: 480px) { .cert { padding: 22px 18px; } .cert-row { flex-direction: column; } .cert-row .btn { width: 100%; justify-content: center; } .cert-result :global(dl) { grid-template-columns: 1fr; gap: 0; } .cert-result :global(dt) { font-size: 12.5px; margin-top: 6px; } }

  @media (max-width: 960px) {
    .hero, .form-wrap { grid-template-columns: 1fr; }
    .device { width: 240px; transform: none; }
    .portal { grid-template-columns: 1fr; }
    .form-intro { position: static; }
  }
  @media (max-width: 480px) { .two { grid-template-columns: 1fr; } }
</style>

<script>
  import { olay } from '../../scripts/olay';
  // Eski portal bağlantıları (online-egitim.html#dashboard vb.) yeni portala gider
  const OLD_VIEWS = ['admin', 'ai-mentor', 'baglama-menu', 'dashboard', 'ders-kayitlari', 'ear-training', 'exam-categories', 'exam-detail', 'exam-list', 'fa-key', 'fun-learning', 'generator', 'live-class', 'makam-ustadi', 'materials', 'memory-game', 'metronome', 'musical-memory', 'nota-yagmuru', 'quiz-game', 'tools-menu', 'tsm-game', 'tuner'];
  if (OLD_VIEWS.includes(location.hash.slice(1))) {
    location.replace('/portal/');
  }

  // iPhone kurulum kılavuzu ve Android indirme penceresi
  const openDialog = (d: HTMLDialogElement | null) => {
    if (!d) return;
    if (typeof d.showModal === 'function') { if (!d.open) d.showModal(); } else d.setAttribute('open', '');
    document.documentElement.style.overflow = 'hidden';
  };
  const guide = document.querySelector<HTMLDialogElement>('[data-ios-guide]');
  const apkGuide = document.querySelector<HTMLDialogElement>('[data-apk-guide]');
  [guide, apkGuide].forEach((d) => {
    d?.addEventListener('close', () => { if (!guide?.open && !apkGuide?.open) document.documentElement.style.overflow = ''; });
    // Pencerenin dışına (bulanık zemine) dokununca kapanır
    d?.addEventListener('click', (e) => { if (e.target === d) d.close(); });
  });
  guide?.querySelector('[data-ios-close]')?.addEventListener('click', () => guide.close());
  apkGuide?.querySelectorAll('[data-apk-close]').forEach((b) => b.addEventListener('click', () => apkGuide.close()));
  document.querySelectorAll('[data-ios-open]').forEach((b) => b.addEventListener('click', () => openDialog(guide)));
  // APK indirmesi kendiliğinden sürer; pencere kurulumu ve güvenliği anlatır
  document.querySelectorAll('[data-apk]').forEach((a) => a.addEventListener('click', () => {
    olay('apk_indir');
    setTimeout(() => openDialog(apkGuide), 150);
  }));

  // Sertifika sorgulama: herkese açık doğrulama kaydı (sertifika_dogrula/{no}) Firestore REST ile okunur.
  // Kayıtta yalnız adların ilk iki harfi, program ve tarih durur.
  const FS_DOC = 'https://firestore.googleapis.com/v1/projects/baglamagram-portal/databases/(default)/documents/sertifika_dogrula/';
  const FS_KEY = 'AIzaSyBIx9TujKPX82NaWXGh2QTxyG6TEQ-abi8';
  const certForm = document.querySelector<HTMLFormElement>('[data-cert]');
  const normalizeNo = (v: string) => {
    const s = v.toUpperCase().replace(/[^A-Z0-9]/g, '');
    const m = s.match(/^BG(\d{4})([A-Z0-9]{4})([A-Z0-9]{4})$/);
    return m ? `BG-${m[1]}-${m[2]}-${m[3]}` : '';
  };
  const esc = (v: string) => v.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));
  certForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const d = certForm.dataset;
    const out = certForm.querySelector<HTMLElement>('[data-cert-result]');
    const btn = certForm.querySelector<HTMLButtonElement>('button[type=submit]');
    const label = certForm.querySelector<HTMLElement>('[data-cert-btn]');
    const input = certForm.querySelector<HTMLInputElement>('input[name=no]');
    if (!out || !input) return;
    const show = (ok: boolean, html: string) => { out.hidden = false; out.className = `cert-result ${ok ? 'ok' : 'bad'}`; out.innerHTML = html; };
    const bad = (title: string, text: string) => show(false, `<span class="mark">✕</span><div><h3>${esc(title)}</h3><p>${esc(text)}</p></div>`);
    const no = normalizeNo(input.value);
    if (!no) { bad(d.invalid || '', d.invalidText || ''); return; }
    input.value = no;
    if (btn) btn.disabled = true;
    if (label) label.textContent = d.wait || '';
    try {
      const res = await fetch(`${FS_DOC}${encodeURIComponent(no)}?key=${FS_KEY}`);
      if (res.status === 404) { bad(d.invalid || '', d.invalidText || ''); return; }
      if (!res.ok) throw new Error(String(res.status));
      const f = (await res.json()).fields || {};
      if (f.gecerli && f.gecerli.booleanValue === false) { bad(d.invalid || '', d.revoked || ''); return; }
      const program = (d as Record<string, string | undefined>)[`p-${f.program?.stringValue}`.replace(/-([a-z])/g, (_m, c) => c.toUpperCase())] || '';
      let date = '';
      try { date = new Date(f.tarih?.timestampValue).toLocaleDateString(d.locale || 'tr-TR', { day: 'numeric', month: 'long', year: 'numeric' }); } catch (_) { date = ''; }
      show(true, `<span class="mark">✓</span><div><h3>${esc(d.valid || '')}</h3><dl>`
        + `<dt>${esc(d.holder || '')}</dt><dd>${esc(f.kisaltma?.stringValue || '')}</dd>`
        + (program ? `<dt>${esc(d.program || '')}</dt><dd>${esc(program)}</dd>` : '')
        + (date ? `<dt>${esc(d.date || '')}</dt><dd>${esc(date)}</dd>` : '')
        + `<dt>No</dt><dd>${esc(no)}</dd></dl></div>`);
    } catch (_) {
      bad(d.error || '', '');
    } finally {
      if (btn) btn.disabled = false;
      if (label) label.textContent = d.btn || '';
    }
  });

  // Başvuruyu Firestore'a (basvurular, kaynak: site) yazar; kurallar girişsiz eklemeye izin verir, tarih sunucu saati.
  const LEVEL: Record<string, string> = { sifir: 'Hiç bilmiyorum', temel: 'Başlangıç', ileri: 'İleri' };
  async function saveToApp(d: FormData) {
    const str = (k: string, n: number) => ({ stringValue: String(d.get(k) || '').trim().slice(0, n) });
    const fields = {
      ad_soyad: str('ad_soyad', 80), telefon: str('telefon', 30), yas: str('yas', 3), meslek: str('meslek', 80),
      seviye: { stringValue: LEVEL[String(d.get('seviye') || '')] || '' }, mesaj: str('mesaj', 1000),
      kaynak: { stringValue: 'site' }, durum: { stringValue: 'yeni' },
    };
    const id = `s${Date.now().toString(36)}${Math.random().toString(36).slice(2, 8)}`;
    const base = 'projects/baglamagram-portal/databases/(default)/documents';
    await fetch(`https://firestore.googleapis.com/v1/${base}:commit?key=${FS_KEY}`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ writes: [{
        update: { name: `${base}/basvurular/${id}`, fields },
        updateTransforms: [{ fieldPath: 'tarih', setToServerValue: 'REQUEST_TIME' }],
        currentDocument: { exists: false },
      }] }),
    });
  }

  // Başvuru formu: sayfadan ayrılmadan gönder
  const form = document.querySelector<HTMLFormElement>('[data-apply]');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const status = form.querySelector<HTMLElement>('[data-status]');
    const btn = form.querySelector<HTMLButtonElement>('button[type=submit]');
    if (btn) btn.disabled = true;
    try {
      const data = new FormData(form);
      // Başvuru, uygulamanın Yönetim › Deneme dersi başvuruları listesine de düşer (en iyi çaba; e-posta yolu bozulmaz)
      if (!data.get('_gotcha')) saveToApp(data).catch(() => {});
      const res = await fetch(form.action, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      if (status) { status.textContent = form.dataset.sent || ''; status.className = 'status ok'; }
    } catch (_) {
      if (status) { status.textContent = form.dataset.error || ''; status.className = 'status err'; }
    } finally {
      if (btn) btn.disabled = false;
    }
  });
</script>
