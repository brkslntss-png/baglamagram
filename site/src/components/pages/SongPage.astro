---
import Base from '../../layouts/Base.astro';
import Icon from '../Icon.astro';
import Lightbox from '../Lightbox.astro';
import { href, t, type Lang } from '../../i18n';
import type { Song } from '../../data/songs';
interface Props { lang: Lang; song: Song }
const { lang, song } = Astro.props;
---
<Base title={`${song.title} · ${t(lang, 'notes.title')}`} description={`${song.title} — ${t(lang, 'notes.by', { name: song.by })}`}>
  <section class="page-hero">
    <div class="container">
      <a class="link-arrow back" href={href(lang, 'notalar.html')}><Icon name="arrow-left" size={17} />{t(lang, 'notes.back')}</a>
      <h1 class="title-xl">{song.title}</h1>
      <p class="muted">{t(lang, 'notes.by', { name: song.by })}</p>
    </div>
  </section>
  <section class="section-tight">
    <div class="container song">
      <div class="sheets">
        {song.images.map((src, i) => (
          <a class="sheet" href={src} data-zoom data-alt={`${song.title} — ${t(lang, 'notes.page', { n: i + 1 })}`}>
            <img src={src} alt={`${song.title} — ${t(lang, 'notes.page', { n: i + 1 })}`} loading={i ? 'lazy' : 'eager'} decoding="async" />
            <span class="zoom"><Icon name="zoom-in" size={16} />{song.images.length > 1 ? `${t(lang, 'notes.page', { n: i + 1 })} · ` : ''}{t(lang, 'notes.zoom')}</span>
          </a>
        ))}
      </div>
      <aside class="side">
        <div class="card lyrics">
          <h2>{t(lang, 'notes.lyrics')}</h2>
          <p class="serif" lang="tr">{song.lyrics}</p>
        </div>
        <a class="btn btn-gold" href={`/${song.pdf}`} download><Icon name="download" size={18} />{t(lang, 'notes.pdf')}</a>
      </aside>
    </div>
  </section>
  <Lightbox closeLabel={t(lang, 'nav.close')} />
</Base>
<style>
  .page-hero .container { gap: 12px; }
  .back { margin-bottom: 8px; }
  .song { display: grid; grid-template-columns: 1.3fr 0.7fr; gap: 32px; align-items: start; }
  .sheets { display: flex; flex-direction: column; gap: 20px; }
  .sheet { position: relative; display: block; background: #fff; border-radius: 18px; overflow: hidden; border: 1px solid var(--line-2); box-shadow: var(--shadow); cursor: zoom-in; }
  .sheet img { width: 100%; }
  .zoom { position: absolute; left: 12px; bottom: 12px; display: inline-flex; gap: 8px; align-items: center; padding: 8px 12px; border-radius: 999px; background: rgba(10, 10, 11, 0.8); color: var(--text); font-size: 13px; font-weight: 600; }
  .side { position: sticky; top: calc(var(--header-h) + 24px); display: flex; flex-direction: column; gap: 14px; }
  .lyrics { padding: 24px; }
  .lyrics h2 { font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--gold); font-family: var(--sans); margin-bottom: 14px; }
  .lyrics p { white-space: pre-line; font-size: 18px; line-height: 1.8; font-style: italic; color: var(--text); }
  @media (max-width: 900px) { .song { grid-template-columns: 1fr; } .side { position: static; } }
</style>
