---
import Base from '../../layouts/Base.astro';
import Icon from '../Icon.astro';
import YouTube from '../YouTube.astro';
import { href, t, type Lang } from '../../i18n';
import type { UIKey } from '../../i18n/ui';
import { CREATIVE_VIDEOS, IMG, INSTAGRAM } from '../../data/site';
import { QUOTES, quoteIndexFor } from '../../data/quotes';
import { LISTED_POEMS, excerpt, poemUrl } from '../../data/poems';
import { CONCERT_FEATURED } from '../../data/concerts';
interface Props { lang: Lang }
const { lang } = Astro.props;
const q = QUOTES[quoteIndexFor()];
const poems = LISTED_POEMS.slice(0, 3);
const c = CONCERT_FEATURED;
// Online dersin artıları (sayaç şeridinin sağı)
const WHY = [['house', 1], ['globe', 2], ['calendar-clock', 3]] as const;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Mahmut Burak Aslantaş',
  alternateName: 'Mahmut Burak',
  url: 'https://baglamagram.com.tr',
  image: `https://baglamagram.com.tr${IMG.portrait.full}`,
  jobTitle: lang === 'tr' ? 'Müzisyen, müzik öğretmeni' : 'Musician, music teacher',
  knowsAbout: ['Bağlama', 'Türkü', 'Türk Halk Müziği', 'Saz', 'Müzik Eğitimi'],
  birthDate: '2002-02-08',
  sameAs: ['https://www.instagram.com/baglamagram', 'https://open.spotify.com/intl-tr/artist/5rXy7D9yXqn3kOvLYXDxft', 'https://www.youtube.com/@baglamagram'],
};
const quotesForClient = QUOTES.map((x) => ({ t: x.text[lang], a: x.author?.[lang] || '' }));
---
<Base jsonLd={jsonLd}>
  <!-- Giriş -->
  <section class="hero">
    <div class="glow" aria-hidden="true"></div>
    <div class="container hero-grid">
      <div class="hero-text">
        <h1 class="title-xl">Mahmut Burak <span class="gold-grad">Aslantaş</span></h1>
        <blockquote class="hero-quote">
          <p>“{t(lang, 'home.quote')}”</p>
          <cite>{t(lang, 'home.quoteAuthor')}</cite>
        </blockquote>
        <div class="cta">
          <a class="btn btn-gold" href={href(lang, 'online-egitim.html')}><Icon name="graduation-cap" size={18} />{t(lang, 'home.ctaEdu')}</a>
          <a class="btn btn-ghost" href={href(lang, 'konserler.html')}>{t(lang, 'home.ctaConcerts')}<Icon name="arrow-right" size={17} /></a>
        </div>
      </div>
      <div class="hero-photo">
        <div class="frame">
          <img src={IMG.portrait.src} srcset={IMG.portrait.srcset} sizes="(max-width: 960px) 80vw, 440px" width={IMG.portrait.w} height={IMG.portrait.h} alt="Mahmut Burak Aslantaş" fetchpriority="high" decoding="async" />
        </div>
        <div class="badge"><span class="dot"></span>{t(lang, 'home.badge')}</div>
      </div>
    </div>
  </section>

  <!-- Sayılar -->
  <section class="container stats reveal">
    <div class="stat"><strong>500+</strong><span>{t(lang, 'home.stat.lessons')}</span></div>
    <ul class="why">
      {WHY.map(([icon, i]) => (
        <li>
          <span class="icon-tile"><Icon name={icon} size={20} /></span>
          <div><h3>{t(lang, `home.why.${i}.t` as UIKey)}</h3><p>{t(lang, `home.why.${i}.d` as UIKey)}</p></div>
        </li>
      ))}
    </ul>
  </section>

  <!-- Online eğitim -->
  <section class="section">
    <div class="container edu reveal">
      <div class="edu-text">
        <span class="eyebrow">{t(lang, 'home.edu.eyebrow')}</span>
        <h2 class="title-lg">{t(lang, 'home.edu.title')}</h2>
        <p class="lead">{t(lang, 'home.edu.text')}</p>
        <div class="cta">
          <a class="btn btn-gold" href={href(lang, 'online-egitim.html')}>{t(lang, 'home.edu.cta')}<Icon name="arrow-right" size={17} /></a>
          <span class="chip"><Icon name="gift" size={14} />{t(lang, 'home.edu.trial')}</span>
        </div>
      </div>
      <ul class="edu-list">
        <li class="card"><span class="icon-tile"><Icon name="video" size={22} /></span><div><h3>{t(lang, 'edu.f.live.t')}</h3><p>{t(lang, 'edu.f.live.d')}</p></div></li>
        <li class="card"><span class="icon-tile"><Icon name="mic" size={22} /></span><div><h3>{t(lang, 'edu.f.hw.t')}</h3><p>{t(lang, 'edu.f.hw.d')}</p></div></li>
        <li class="card"><span class="icon-tile"><Icon name="sparkles" size={22} /></span><div><h3>{t(lang, 'edu.f.ai.t')}</h3><p>{t(lang, 'edu.f.ai.d')}</p></div></li>
        <li class="card"><span class="icon-tile"><Icon name="gamepad-2" size={22} /></span><div><h3>{t(lang, 'edu.f.tools.t')}</h3><p>{t(lang, 'edu.f.tools.d')}</p></div></li>
      </ul>
    </div>
  </section>

  <!-- Günün sözü -->
  <section class="section-tight quote-day reveal">
    <div class="container narrow center">
      <span class="eyebrow center">{t(lang, 'home.quoteOfDay')}</span>
      <p class="qd-text serif" data-qd-text>“{q.text[lang]}”</p>
      <p class="qd-author" data-qd-author>{q.author?.[lang] || ''}</p>
    </div>
    <script type="application/json" data-qd-list set:html={JSON.stringify(quotesForClient)} />
  </section>

  <!-- Videolar -->
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">{t(lang, 'home.creative.eyebrow')}</span>
        <div class="row-between">
          <h2 class="title-lg">{t(lang, 'home.creative.title')}</h2>
          <a class="link-arrow" href="https://www.youtube.com/@baglamagram" target="_blank" rel="noopener noreferrer"><Icon name="youtube" size={18} />{t(lang, 'common.watchOnYoutube')}</a>
        </div>
      </div>
      <div class="grid grid-3 reveal">
        {CREATIVE_VIDEOS.map((id) => <YouTube id={id} label={t(lang, 'common.playVideo')} />)}
      </div>
    </div>
  </section>

  <!-- Konser -->
  <section class="section concert-wrap">
    <div class="container concert reveal">
      <a class="poster" href={href(lang, 'konserler.html')}><img src={c.poster.src} srcset={c.poster.srcset} sizes="(max-width: 960px) 90vw, 440px" width={c.poster.w} height={c.poster.h} alt={c.title} loading="lazy" decoding="async" /></a>
      <div class="concert-text">
        <span class="eyebrow">{t(lang, 'home.concert.eyebrow')}</span>
        <h2 class="title-lg">{c.title}</h2>
        <p class="lead">{c.desc[lang]}</p>
        <ul class="meta">
          <li><Icon name="calendar" size={17} />{c.date[lang]}</li>
          <li><Icon name="map-pin" size={17} />{c.place[lang]}</li>
        </ul>
        <a class="link-arrow" href={href(lang, 'konserler.html')}>{t(lang, 'home.concert.cta')}<Icon name="arrow-right" size={17} /></a>
      </div>
    </div>
  </section>

  <!-- Şiirler -->
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">{t(lang, 'home.poems.eyebrow')}</span>
        <div class="row-between">
          <h2 class="title-lg">{t(lang, 'home.poems.title')}</h2>
          <a class="link-arrow" href={href(lang, 'siirler.html')}>{t(lang, 'home.poems.cta')}<Icon name="arrow-right" size={17} /></a>
        </div>
      </div>
      <div class="grid grid-3 reveal">
        {poems.map((p) => (
          <a class="card poem" href={href(lang, poemUrl(p.slug))} lang="tr">
            <Icon name="feather" size={20} class="gold" />
            <h3 class="serif">{p.title}</h3>
            <p>{excerpt(p)}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Instagram -->
  <section class="section-tight">
    <div class="container">
      <a class="insta-head reveal" href="https://www.instagram.com/baglamagram" target="_blank" rel="noopener noreferrer"><Icon name="instagram" size={20} />{t(lang, 'home.insta.title')}</a>
      <div class="insta reveal">
        {INSTAGRAM.map((src, i) => (
          <a href="https://www.instagram.com/baglamagram" target="_blank" rel="noopener noreferrer" aria-label={`Instagram ${i + 1}`}>
            <img src={src} alt="" loading="lazy" decoding="async" />
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { position: relative; padding: calc(var(--header-h) + clamp(32px, 6vw, 80px)) 0 clamp(48px, 7vw, 96px); overflow: hidden; }
  .glow { position: absolute; inset: 0; pointer-events: none;
    background:
      radial-gradient(60% 50% at 75% 30%, rgba(210, 172, 99, 0.16), transparent 70%),
      radial-gradient(40% 40% at 10% 80%, rgba(210, 172, 99, 0.07), transparent 70%); }
  .hero-grid { position: relative; display: grid; grid-template-columns: 1.15fr 0.85fr; gap: clamp(32px, 6vw, 80px); align-items: center; }
  .hero-text { display: flex; flex-direction: column; gap: 26px; }
  .gold-grad { display: block; background: linear-gradient(100deg, var(--gold-2), var(--gold) 45%, var(--gold-deep)); -webkit-background-clip: text; background-clip: text; color: transparent; font-style: italic; }
  .hero-quote { margin: 0; padding-left: 20px; border-left: 1px solid var(--gold-line); max-width: 520px; }
  .hero-quote p { font-family: var(--serif); font-style: italic; font-size: clamp(17px, 1.6vw, 20px); color: var(--text-2); line-height: 1.55; }
  .hero-quote cite { display: block; margin-top: 8px; font-style: normal; font-size: 13px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gold); }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
  .hero-photo { position: relative; justify-self: end; width: min(100%, 440px); }
  .frame { position: relative; border-radius: 32px; overflow: hidden; aspect-ratio: 4 / 5; background: var(--surface); border: 1px solid var(--gold-line); box-shadow: 0 40px 120px -40px rgba(210, 172, 99, 0.35), var(--shadow); }
  /* Fotoğrafın kenarları saydam, ortaya doğru tam görünür */
  .frame img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%;
    -webkit-mask-image: radial-gradient(ellipse 54% 56% at 50% 42%, #000 46%, rgba(0, 0, 0, 0.8) 58%, rgba(0, 0, 0, 0.5) 70%, rgba(0, 0, 0, 0.22) 82%, rgba(0, 0, 0, 0.06) 92%, transparent 100%);
    mask-image: radial-gradient(ellipse 54% 56% at 50% 42%, #000 46%, rgba(0, 0, 0, 0.8) 58%, rgba(0, 0, 0, 0.5) 70%, rgba(0, 0, 0, 0.22) 82%, rgba(0, 0, 0, 0.06) 92%, transparent 100%); }
  .frame::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 55%, rgba(10, 10, 11, 0.55)); }
  .badge { position: absolute; left: -24px; bottom: 28px; display: inline-flex; align-items: center; gap: 10px; padding: 12px 16px; border-radius: 16px; background: rgba(20, 20, 22, 0.86); border: 1px solid var(--line-2); font-size: 13px; font-weight: 600; backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); box-shadow: var(--shadow); }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--gold); box-shadow: 0 0 0 4px var(--gold-soft); }

  .stats { width: calc(100% - 2 * var(--gutter)); padding: 0 clamp(20px, 3vw, 40px); display: grid; grid-template-columns: auto 1fr; align-items: center; border: 1px solid var(--line); border-radius: var(--radius-lg); background: linear-gradient(180deg, var(--surface), var(--bg-2)); }
  .stat { padding: clamp(20px, 3vw, 32px) clamp(24px, 3.4vw, 44px) clamp(20px, 3vw, 32px) 0; display: flex; flex-direction: column; gap: 4px; align-items: flex-start; border-right: 1px solid var(--line); align-self: stretch; justify-content: center; }
  .stat strong { font-family: var(--serif); font-size: clamp(36px, 4.4vw, 54px); font-weight: 600; color: var(--gold-2); line-height: 1.05; }
  .stat span { font-size: 14px; color: var(--text-2); white-space: nowrap; }
  .why { list-style: none; margin: 0; padding: clamp(18px, 2.6vw, 28px) 0 clamp(18px, 2.6vw, 28px) clamp(24px, 3.4vw, 44px); display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(16px, 2.4vw, 28px); }
  .why li { display: flex; gap: 14px; align-items: flex-start; }
  .why .icon-tile { flex: none; width: 42px; height: 42px; border-radius: 12px; }
  .why h3 { font-size: 15px; font-weight: 600; line-height: 1.35; margin-bottom: 4px; }
  .why p { font-size: 13.5px; color: var(--text-2); line-height: 1.5; }

  .edu { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 5vw, 64px); align-items: center; }
  .edu-text { display: flex; flex-direction: column; gap: 20px; }
  .edu-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .edu-list li { padding: 22px; display: flex; flex-direction: column; gap: 14px; }
  .edu-list h3 { font-size: 16px; font-weight: 600; margin-bottom: 4px; }
  .edu-list p { font-size: 14px; color: var(--text-2); line-height: 1.55; }

  .quote-day { border-block: 1px solid var(--line); background: radial-gradient(60% 120% at 50% 0%, rgba(210, 172, 99, 0.08), transparent 70%); }
  .quote-day .container { display: flex; flex-direction: column; align-items: center; gap: 18px; }
  .qd-text { font-size: clamp(22px, 3vw, 34px); font-style: italic; line-height: 1.4; }
  .qd-author { font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gold); min-height: 1em; }

  .concert-wrap { background: linear-gradient(180deg, transparent, rgba(210, 172, 99, 0.04), transparent); }
  .concert { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(28px, 5vw, 64px); align-items: center; }
  .poster { display: block; border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--line-2); aspect-ratio: 1131 / 1600; background: var(--surface); box-shadow: var(--shadow); }
  .poster img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease; }
  .poster:hover img { transform: scale(1.03); }
  .concert-text { display: flex; flex-direction: column; gap: 18px; }
  .meta { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px 24px; color: var(--text-2); font-size: 14px; }
  .meta li { display: inline-flex; align-items: center; gap: 8px; }
  .meta :global(.icon) { color: var(--gold); }

  .poem { padding: 26px; display: flex; flex-direction: column; gap: 12px; min-height: 200px; }
  .poem h3 { font-size: 24px; }
  .poem p { color: var(--text-2); font-family: var(--serif); font-style: italic; font-size: 16px; line-height: 1.6; }

  .insta-head { display: inline-flex; align-items: center; gap: 10px; font-weight: 600; color: var(--text-2); margin-bottom: 18px; }
  .insta-head:hover { color: var(--gold-2); }
  .insta { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  .insta a { display: block; aspect-ratio: 1; border-radius: 16px; overflow: hidden; background: var(--surface); border: 1px solid var(--line); }
  .insta img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease, opacity 0.3s; opacity: 0.9; }
  .insta a:hover img { transform: scale(1.05); opacity: 1; }

  @media (max-width: 960px) {
    .hero-grid, .edu, .concert { grid-template-columns: 1fr; }
    .hero-photo { justify-self: center; width: min(100%, 380px); order: -1; }
    .badge { left: 50%; transform: translateX(-50%); bottom: -18px; white-space: nowrap; }
    .hero-text { align-items: flex-start; }
    .poster { max-width: 420px; }
    .stats { grid-template-columns: 1fr; }
    .stat { border-right: 0; border-bottom: 1px solid var(--line); flex-direction: row; align-items: baseline; justify-content: flex-start; gap: 12px; padding-block: 20px; }
    .why { grid-template-columns: 1fr; padding-left: 0; }
  }
  @media (max-width: 640px) {
    .edu-list { grid-template-columns: 1fr; }
    .insta { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<script>
  // Günün sözünü ziyaretçinin bugününe göre seç (derleme günü değil)
  const list = document.querySelector('[data-qd-list]');
  if (list) {
    try {
      const qs = JSON.parse(list.textContent || '[]');
      const d = new Date();
      const day = Math.floor((Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()) - Date.UTC(d.getFullYear(), 0, 0)) / 86400000);
      const q = qs[day % qs.length];
      const te = document.querySelector('[data-qd-text]');
      const ae = document.querySelector('[data-qd-author]');
      if (q && te && ae) { te.textContent = `“${q.t}”`; ae.textContent = q.a; }
    } catch (_) {}
  }
</script>
