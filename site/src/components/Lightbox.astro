---
// Görsel büyütme penceresi: [data-zoom] olan bağlantıya tıklayınca açılır.
import Icon from './Icon.astro';
interface Props { closeLabel: string }
const { closeLabel } = Astro.props;
---
<dialog class="lightbox" data-lightbox>
  <button type="button" class="lb-close" data-lb-close aria-label={closeLabel}><Icon name="x" size={22} /></button>
  <img alt="" data-lb-img />
</dialog>
<style>
  .lightbox { border: 0; padding: 0; background: transparent; max-width: 100vw; max-height: 100vh; width: 100vw; height: 100vh; }
  .lightbox::backdrop { background: rgba(0, 0, 0, 0.92); backdrop-filter: blur(6px); }
  .lightbox[open] { display: grid; place-items: center; overflow: auto; }
  .lightbox img { max-width: min(96vw, 1400px); max-height: none; width: auto; background: #fff; border-radius: 8px; cursor: zoom-out; }
  .lb-close { position: fixed; top: 16px; right: 16px; width: 48px; height: 48px; border-radius: 50%; border: 1px solid var(--line-2); background: rgba(20, 20, 22, 0.9); color: var(--text); cursor: pointer; display: grid; place-items: center; z-index: 2; }
</style>
<script>
  const dlg = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const img = dlg?.querySelector<HTMLImageElement>('[data-lb-img]');
  document.querySelectorAll<HTMLAnchorElement>('[data-zoom]').forEach((a) => a.addEventListener('click', (e) => {
    if (!dlg || !img) return;
    e.preventDefault();
    img.src = a.href; img.alt = a.dataset.alt || '';
    dlg.showModal();
  }));
  dlg?.querySelector('[data-lb-close]')?.addEventListener('click', () => dlg.close());
  img?.addEventListener('click', () => dlg?.close());
  dlg?.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
</script>
