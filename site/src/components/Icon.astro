---
// SVG simge: Lucide (ISC) çizgi simgeleri ve Simple Icons (CC0) marka simgeleri, derleme anında gömülür.
import fs from 'node:fs';
import { createRequire } from 'node:module';
interface Props { name: string; size?: number; class?: string; label?: string; stroke?: number }
const { name, size = 20, class: cls = '', label, stroke = 1.75 } = Astro.props;
const require = createRequire(import.meta.url);
const BRANDS = ['instagram', 'youtube', 'spotify', 'whatsapp'];
// Simple Icons'ta olmayan ya da sürüme göre değişen marka simgeleri (Apple, Android) burada gömülü durur
const INLINE: Record<string, string> = {
  apple: 'M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701',
  android: 'M17.6 9.48l1.84-3.18c.16-.31.04-.69-.26-.85a.637.637 0 0 0-.83.22l-1.88 3.24a11.43 11.43 0 0 0-8.94 0L5.65 5.67a.643.643 0 0 0-.87-.2c-.28.18-.37.54-.22.83L6.4 9.48A10.78 10.78 0 0 0 1 18h22a10.78 10.78 0 0 0-5.4-8.52zM7 15.25a1.25 1.25 0 1 1 0-2.5 1.25 1.25 0 0 1 0 2.5zm10 0a1.25 1.25 0 1 1 0-2.5 1.25 1.25 0 0 1 0 2.5z',
};
let svg = '';
if (INLINE[name]) {
  svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="${size}" height="${size}" fill="currentColor"><path d="${INLINE[name]}"/></svg>`;
} else if (BRANDS.includes(name)) {
  const raw = fs.readFileSync(require.resolve(`simple-icons/icons/${name}.svg`), 'utf8');
  const d = raw.match(/<path d="([^"]+)"/)?.[1] ?? '';
  svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="${size}" height="${size}" fill="currentColor"><path d="${d}"/></svg>`;
} else {
  const raw = fs.readFileSync(require.resolve(`lucide-static/icons/${name}.svg`), 'utf8');
  const inner = raw.replace(/<!--.*?-->/s, '').replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');
  svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="${size}" height="${size}" fill="none" stroke="currentColor" stroke-width="${stroke}" stroke-linecap="round" stroke-linejoin="round">${inner}</svg>`;
}
---
<span class={`icon ${cls}`} aria-hidden={label ? undefined : 'true'} role={label ? 'img' : undefined} aria-label={label} set:html={svg} />
