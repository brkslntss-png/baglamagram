---
import Icon from './Icon.astro';
import { href, t, type Lang } from '../i18n';
import { SOCIAL, YASAL } from '../data/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="top">
      <div class="about">
        <span class="wordmark" aria-hidden="true"></span>
        <div class="social">
          {SOCIAL.map((s) => (
            <a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={s.name}><Icon name={s.icon} size={18} /></a>
          ))}
        </div>
      </div>
      <div class="cols">
        <div>
          <h3>{t(lang, 'footer.explore')}</h3>
          <a href={href(lang, 'hakkinda.html')}>{t(lang, 'nav.about')}</a>
          <a href={href(lang, 'notalar.html')}>{t(lang, 'nav.notes')}</a>
          <a href={href(lang, 'siirler.html')}>{t(lang, 'nav.poems')}</a>
          <a href={href(lang, 'konserler.html')}>{t(lang, 'nav.concerts')}</a>
          <a href={href(lang, 'blog.html')}>{t(lang, 'nav.blog')}</a>
        </div>
        <div>
          <h3>{t(lang, 'footer.education')}</h3>
          <a href={href(lang, 'online-egitim.html')}>{t(lang, 'nav.edu')}</a>
          <a href={href(lang, 'magaza.html')}>{t(lang, 'nav.packages')}</a>
          <a href="/portal/">{t(lang, 'nav.login')}</a>
          <a href={href(lang, 'online-egitim.html') + '#basvuru'} class="gold">{t(lang, 'footer.trial')}</a>
        </div>
        <div>
          <h3>{t(lang, 'footer.legal')}</h3>
          {YASAL.map((y) => <a href={href(lang, y.page)}>{t(lang, y.key)}</a>)}
        </div>
      </div>
    </div>
    <hr class="hairline" />
    <div class="bottom">
      <span>© {year} Mahmut Burak ASLANTAŞ. {t(lang, 'footer.rights')}</span>
      <span class="muted">baglamagram.com.tr</span>
    </div>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--line); background: linear-gradient(180deg, var(--bg), #060607); padding: 64px 0 28px; margin-top: 40px; }
  .top { display: grid; grid-template-columns: 1fr 1.4fr; gap: 48px; padding-bottom: 40px; }
  .about { display: flex; flex-direction: column; gap: 18px; max-width: 420px; }
  .about p { font-size: 15px; }
  .wordmark {
    display: block; width: 170px; height: 30px; background: linear-gradient(90deg, var(--gold-2), var(--gold));
    -webkit-mask: url('/img/wordmark.png') left center / contain no-repeat; mask: url('/img/wordmark.png') left center / contain no-repeat;
  }
  .social { display: flex; gap: 10px; }
  .social a { width: 42px; height: 42px; border-radius: 50%; display: grid; place-items: center; border: 1px solid var(--line-2); color: var(--text-2); transition: color 0.2s, border-color 0.2s, background 0.2s; }
  .social a:hover { color: var(--gold-2); border-color: var(--gold-line); background: var(--gold-soft); }
  .cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }
  .cols h3 { font-family: var(--sans); font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-3); margin-bottom: 14px; font-weight: 600; }
  .cols div { display: flex; flex-direction: column; gap: 10px; }
  .cols a { color: var(--text-2); font-size: 15px; width: fit-content; }
  .cols a:hover { color: var(--text); }
  .cols a.gold { color: var(--gold); }
  .bottom { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding-top: 24px; font-size: 13px; color: var(--text-3); }
  @media (max-width: 760px) { .top { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .cols { grid-template-columns: 1fr 1fr; } }
</style>
